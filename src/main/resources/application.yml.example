# Example Application Configuration
# This file shows the expected structure.
# Real values are loaded from environment variables.

spring:
    application:
        name: weekly-tasks-backend

    servlet:
        multipart:
            max-file-size: 50MB
            max-request-size: 50MB

    datasource:
        url: ${DATASOURCE_URL}
        username: ${DATASOURCE_USERNAME}
        password: ${DATASOURCE_PASSWORD}
        driver-class-name: com.mysql.cj.jdbc.Driver
        hikari:
            maximum-pool-size: 10
            minimum-idle: 5
            connection-timeout: 60000
            idle-timeout: 600000
            max-lifetime: 1800000
            connection-test-query: SELECT 1

    jpa:
        hibernate:
            ddl-auto: update
        show-sql: true
        properties:
            hibernate:
                dialect: org.hibernate.dialect.MySQL8Dialect
                format_sql: true

server:
    port: ${PORT}

cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS}

reidoscoins:
    api:
        url: ${REIDOSCOINS_API_URL}
        token: ${REIDOSCOINS_API_TOKEN}

tibiadraptor:
    api:
        url: ${TIBIADRAPTOR_API_URL}
    sync:
        enabled: ${TIBIADRAPTOR_SYNC_ENABLED}

logging:
    level:
        root: INFO
        com.tibia.weeklytasks: DEBUG
        org.hibernate.SQL: DEBUG
