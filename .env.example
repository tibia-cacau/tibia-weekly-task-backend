# Weekly Tasks Backend - Environment Variables
# Copy this file to .env and fill with your real credentials

# Database Configuration
DATASOURCE_URL=jdbc:mysql://your-mysql-host:3306/your-database?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATASOURCE_USERNAME=your-username
DATASOURCE_PASSWORD=your-password

# Server Configuration
PORT=8080

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,https://tibia-cacau.github.io

# ReidosCoins API (opcional)
REIDOSCOINS_API_URL=https://www.reidoscoins.com.br/index.php
REIDOSCOINS_API_TOKEN=your-api-token-here

# Tibia Draptor API
TIBIADRAPTOR_API_URL=https://tibiadraptor.com/api/v1
TIBIADRAPTOR_SYNC_ENABLED=true
